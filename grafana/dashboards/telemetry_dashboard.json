        "name": "Flight State Transitions",
        "rawQuery": "from(bucket: \"mock_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"state\")\n  |> drop(columns: [\"source\"])\n  |> sort(columns: [\"_time\"])\n  |> difference(nonNegative: false, columns: [\"_value\"])\n  |> filter(fn: (r) => r._value != 0)\n  |> map(fn: (r) => ({_time: r._time, text: r.flight_state}))\n  |> keep(columns: [\"_time\", \"text\"])",
        "showIn": 0,
        "type": "query"
      }
    ]
